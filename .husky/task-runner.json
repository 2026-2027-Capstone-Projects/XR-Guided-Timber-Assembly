{
   "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
   "tasks": [
      {
         "name": "welcome-message-example",
         "command": "bash",
         "args": [ "-c", "echo Husky.Net is awesome!" ],
         "windows": {
            "command": "cmd",
            "args": ["/c", "echo Husky.Net is awesome!" ]
         }
      },
	  {
        "name": "format-staged-cs-assets",
        "command": "dotnet",
        "args": [
          "format",
          "whitespace",
          ".",
          "--folder",
          "--include",
          "${staged}"
        ],
        "include": [
          "Timber-Assembly/Assets/**/*.cs"
        ]
      }
   ]
}
